# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Model used for JARVIS's AI brain (Stage 3). Check
# https://ai.google.dev/gemini-api/docs/models for current options.
JARVIS_MODEL=gemini-3.6-flash

# How many past request/response turns stay in short-term conversation memory.
JARVIS_MAX_HISTORY_TURNS=20

# Safety cap on chained tool calls per request (Stage 4/7 planning loop).
JARVIS_MAX_TOOL_ITERATIONS=8

# search_files/read_document are confined to this directory tree.
# JARVIS_FILES_ROOT=~/Documents

# Off by default: lets the brain run Python it wrote, always with a y/N
# confirmation first. See the README's "A note on safety" before enabling.
JARVIS_ENABLE_CODE_TOOL=false

# Where the persistent memory database (facts/projects/preferences) lives.
# JARVIS_DATA_DIR=~/.jarvis
